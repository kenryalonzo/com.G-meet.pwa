# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string. On Vercel, use a pooled connection string
# from your provider (Neon, Supabase, Vercel Postgres all work) — Prisma
# runs fine against a standard pooled Postgres URL with no extra config.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mydb?schema=public"

# Public URL of the deployment. On Vercel, set this to the production
# domain (e.g. https://your-app.vercel.app) via an env var, since
# VERCEL_URL alone isn't suitable for OAuth callback URLs.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# GitHub OAuth app (github.com/settings/developers)
# Callback URL: {NEXT_PUBLIC_BASE_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth client (console.cloud.google.com)
# Callback URL: {NEXT_PUBLIC_BASE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stream Video (getstream.io) — Video & Audio product
NEXT_PUBLIC_STREAM_VIDEO_API_KEY=""
STREAM_VIDEO_API_SECRET=""
